{
  "name": "slimthicc-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "Internal SlimThicc Command Center for CRM, daily objectives, notes, and ops dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
